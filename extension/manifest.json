{
  "manifest_version": 3,
  "name": "Apple香港库存监控",
  "description": "在香港 Apple 官网会话中查询 Central 附近门店的 iPhone 提取状态并保存本机历史。",
  "version": "4.0.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.apple.com/hk/*",
    "https://www.apple.com/hk-zh/*",
    "https://api.day.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Apple 香港库存监控"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.apple.com/hk/*",
        "https://www.apple.com/hk-zh/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.apple.com/hk/*",
        "https://www.apple.com/hk-zh/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "version_name": "4.0.1 Windows 桌面版内置模块"
}
